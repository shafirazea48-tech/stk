# ─── Required for production (set in Vercel dashboard) ─────────────────────
# Canonical site URL — used for SEO metadata, hreflang, and sitemap
NEXT_PUBLIC_SITE_URL=https://stockity.id

# CTA button redirect target
CTA_URL=https://linkayi.com/stockity-page

# ─── Auto-set by Vercel (do not set manually) ───────────────────────────────
# VERCEL_URL  — deployment URL like my-app-abc123.vercel.app (set by Vercel)

# ─── Replit dev only (do not set on Vercel) ─────────────────────────────────
# REPLIT_DOMAINS — set automatically by Replit
# REPLIT_DEV_DOMAIN — set automatically by Replit

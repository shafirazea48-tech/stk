      "routeKeys": {},
      "namedRegex": "^/go(?:/)?$"
    },
    {
      "page": "/id",
      "regex": "^/id(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/id(?:/)?$"
    },
    {
      "page": "/id/about",
      "regex": "^/id/about(?:/)?$",

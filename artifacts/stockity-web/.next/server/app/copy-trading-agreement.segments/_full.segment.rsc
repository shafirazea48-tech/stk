2d:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"9.2."}]," The Trader uses Copy Trading at their own risk. Starting to use Copy Trading, the Trader accepts responsibility for possible financial losses resulting from the following risks:"]}]
2e:["$","ul",null,{"style":{"paddingLeft":24,"margin":"0 0 1em"},"children":[["$","li","Possible losses, lost profits, etc., which may arise when copying the Trades of one or more Copied Traders",{"style":"$d:props:children:0:props:style","children":"Possible losses, lost profits, etc., which may arise when copying the Trades of one or more Copied Traders"}],["$","li","The risk associated with the inexperience of the Copy Trader who does not have the necessary skills, experience, and/or education to generate the expected or other profits",{"style":"$d:props:children:0:props:style","children":"The risk associated with the inexperience of the Copy Trader who does not have the necessary skills, experience, and/or education to generate the expected or other profits"}],["$","li","The risk of the Copying Trader being unable to access the Trading Platform for objective or subjective reasons",{"style":"$d:props:children:0:props:style","children":"The risk of the Copying Trader being unable to access the Trading Platform for objective or subjective reasons"}],["$","li","The risk of possible claims by tax and financial authorities in the jurisdiction where the Trader is located, registered, or resides",{"style":"$d:props:children:0:props:style","children":"The risk of possible claims by tax and financial authorities in the jurisdiction where the Trader is located, registered, or resides"}]]}]
2f:["$","h2",null,{"style":"$7:props:children:0:1:props:children:props:children:2:props:style","children":"Guarantees and Liability"}]
30:["$","p","10.1.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"10.1."}]," ","The Company does not represent or guarantee the performance of any Copied Trader and/or the recurrence of past results that have been made by a Copied Trader, whose Trades the Trader is copying, and the profits or losses the Trader makes or incurs may not match those of a Copied Trader, whose Trades they are copying."]}]
31:["$","p","10.2.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"10.2."}]," ","The Company shall not be liable for any direct, indirect, or consequential losses, or any other damages that the Trader may incur as a result of using Copy Trading."]}]
32:["$","p","10.3.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"10.3."}]," ","The use of Copy Trading is the Client's choice. It is their sole responsibility to decide whether to copy Trades and copy Trades of specific Copied Traders. In making such decisions, the Client should carefully consider their overall financial situation."]}]
33:["$","p","10.4.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"10.4."}]," ","The Company provides instructions on Copy Trading for informational purposes only. If the Trader makes a decision based on information provided on the Website or obtained through the Copy Trading services, they do it at their own risk."]}]
34:["$","p","10.5.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"10.5."}]," ","In the event of a breach of this Copy Trading Agreement by the Trader and/or if the Company suspects that the Trader is trying to exploit the functional weaknesses, and/or doing fraudulent or malicious activities, the Company shall reserve the right to ban the Trader and terminate this Agreement immediately, as well as to stop their using of Copy Trading."]}]
35:["$","h2",null,{"style":"$7:props:children:0:1:props:children:props:children:2:props:style","children":"Amendment and Termination"}]
36:["$","p","11.1.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"11.1."}]," ","The obligations and rights of the Trader and the Company established by this Copy Trading Agreement are considered a long-term act and are valid until the termination of this Copy Trading Agreement or the Stockity Client Agreement."]}]
37:["$","p","11.2.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"11.2."}]," ","The Trader has the right to terminate this Copy Trading Agreement at any time, regardless of their motives. They can do that through the 'Stop copying' button in the Copy Trading Card for all Copied Traders whose Trades they have started copying. If after that, the Trader decides to resume copying Trades, this Agreement resumes its effect according to the version valid at the time of the resuming."]}]
38:["$","p","11.3.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"11.3."}]," ","The Company has the right to terminate this Agreement unilaterally at any time without providing reasons."]}]
39:["$","p","11.4.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"11.4."}]," ","Upon termination of this Copy Trading Agreement, the copying of Trades on the Trader's Account stops."]}]
3a:["$","p","11.5.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"11.5."}]," ","The Company has the discretion at any time to make amendments to this Copy Trading Agreement. If amendments are made to the Agreement, they will come into force from the moment the amended text of the Agreement is posted on the Website, unless a different term is specified for the amendments to come into force."]}]
3b:["$","p","11.6.",{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"11.6."}]," ","If the Trader does not agree to the amended version of the Agreement, they must terminate it through the 'Stop copying' button in the Copy Trading Card for all Copied Traders whose Trades they have started copying."]}]

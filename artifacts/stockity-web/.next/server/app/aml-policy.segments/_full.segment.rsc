1d:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","em",null,{"style":{"color":"#e0e6f0"},"children":"Validity Checks:"}]," If authenticity is in question, we may use AML database services (including global watchlists: OFAC, UN, EU, and law enforcement or regulatory registries) to verify document legitimacy."]}]

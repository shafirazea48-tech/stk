34:["$","ul",null,{"style":{"paddingLeft":24,"margin":"0 0 1em"},"children":[["$","li","United Nations Security Council sanctions list",{"style":"$f:props:children:0:props:style","children":"United Nations Security Council sanctions list"}],["$","li","OFAC sanctions list",{"style":"$f:props:children:0:props:style","children":"OFAC sanctions list"}],["$","li","EU sanctions list and maps",{"style":"$f:props:children:0:props:style","children":"EU sanctions list and maps"}],["$","li","Vanuatu domestic sanctions measures",{"style":"$f:props:children:0:props:style","children":"Vanuatu domestic sanctions measures"}],["$","li","International sanctions regimes including those maintained by major financial centers",{"style":"$f:props:children:0:props:style","children":"International sanctions regimes including those maintained by major financial centers"}],["$","li","Regional sanctions frameworks applicable to Vanuatu's jurisdiction",{"style":"$f:props:children:0:props:style","children":"Regional sanctions frameworks applicable to Vanuatu's jurisdiction"}]]}]
35:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"7.2"}]," Our advanced screening technology incorporates: real-time screening against consolidated sanctions databases; name-matching algorithms with fuzzy logic capabilities; periodic re-screening of existing Client bases; and transaction screening for sanctions-related indicators."]}]
36:["$","h2",null,{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":"Section 8: Record Keeping and Data Retention"}]
37:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"8.1"}]," In compliance with Vanuatu's record-keeping obligations, We maintain all Client due diligence records, transaction records, and compliance documentation for a minimum period of six years following the cessation of the business relationship or completion of the transaction."]}]
38:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"8.2"}]," We implement robust data protection measures ensuring: (1) confidentiality of Client information in accordance with privacy laws; (2) secure data storage with appropriate access controls; (3) regular backup procedures and disaster recovery protocols; (4) compliance with applicable data protection regulations."]}]

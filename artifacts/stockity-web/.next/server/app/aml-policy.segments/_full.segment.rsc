27:["$","p","4.2",{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"4.2"}]," ","Should it become evident that the Client intends to use their Account solely to exchange funds between payment systems, We reserve the right to refuse any withdrawal requests."]}]
28:["$","p","4.3",{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"4.3"}]," ","If We suspect the Client of fraudulent or deceitful conduct, we may block the Client's Account immediately, without prior notice or the opportunity to withdraw Funds."]}]
29:["$","div",null,{"style":"$24:props:style","children":"ALL SUCH RISK-MITIGATION ACTIONS WILL BE REPORTED, AS PROMPTLY AS PRACTICABLE, TO THE APPROPRIATE GOVERNMENTAL AUTHORITY WHENEVER OUR AML/CFT COMPLIANCE TEAM KNOWS, SUSPECTS, OR HAS REASONABLE GROUNDS TO BELIEVE THAT THE CLIENT IS INVOLVED IN MONEY LAUNDERING OR TERRORIST FINANCING."}]
2a:["$","h2",null,{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":"Section 5: Document Submission and Processing"}]
2b:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"5.1"}]," Clients must provide verification documents in digital format through secure channels. The Company accepts documents in the following formats: JPEG, PNG, PDF, and TIFF. All non-English documents must be accompanied by certified translations prepared by qualified translators."]}]
2c:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"5.2"}]," The Company maintains strict security protocols for document handling: encrypted transmission channels for all document submissions, secure storage systems with access controls and audit trails, and regular security assessments of document management systems."]}]
2d:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"5.3"}]," The Company employs multiple verification methodologies: Enhanced Digital Verification (video verification sessions, real-time document authentication, biometric verification) and Manual Review Processes (expert review by qualified compliance officers, cross-referencing with multiple data sources)."]}]
2e:["$","h2",null,{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":"Section 6: Ongoing Due Diligence Obligations"}]
2f:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"6.1"}]," The Company maintains continuous monitoring of all Client relationships and transactions, ensuring that: (i) transactions remain consistent with the Company's knowledge of the Client; (ii) business activities align with stated purposes and risk profiles; (iii) unusual patterns or suspicious activities are promptly identified; (iv) Client information remains current and accurate."]}]
30:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"6.2"}]," Reporting mechanisms include:"]}]
31:["$","ul",null,{"style":{"paddingLeft":24,"margin":"0 0 1em"},"children":[["$","li","Suspicious Transaction Reports (STRs): all transactions suspected of involving proceeds of crime or terrorist financing must be reported to the VFIU within two working days of identification.",{"style":"$f:props:children:0:props:style","children":"Suspicious Transaction Reports (STRs): all transactions suspected of involving proceeds of crime or terrorist financing must be reported to the VFIU within two working days of identification."}],["$","li","Large Transaction Reports: transactions exceeding prescribed thresholds are subject to enhanced monitoring and potential reporting requirements as established by VFIU guidelines.",{"style":"$f:props:children:0:props:style","children":"Large Transaction Reports: transactions exceeding prescribed thresholds are subject to enhanced monitoring and potential reporting requirements as established by VFIU guidelines."}],["$","li","Cross-Border Transaction Monitoring: particular attention is paid to cross-border transactions, especially those involving high-risk jurisdictions.",{"style":"$f:props:children:0:props:style","children":"Cross-Border Transaction Monitoring: particular attention is paid to cross-border transactions, especially those involving high-risk jurisdictions."}]]}]
32:["$","h2",null,{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":"Section 7: Sanctions Screening and Compliance"}]

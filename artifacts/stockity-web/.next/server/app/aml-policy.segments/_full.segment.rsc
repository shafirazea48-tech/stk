15:["$","ul",null,{"style":{"paddingLeft":24,"margin":"0 0 1em"},"children":[["$","li","A clear photograph of the Client's passport data page or national identity card",{"style":"$f:props:children:0:props:style","children":"A clear photograph of the Client's passport data page or national identity card"}],["$","li","Images of the Client's bank cards or screenshots of their electronic wallets",{"style":"$f:props:children:0:props:style","children":"Images of the Client's bank cards or screenshots of their electronic wallets"}],["$","li","A recent selfie of the Client holding the above document(s) in hand",{"style":"$f:props:children:0:props:style","children":"A recent selfie of the Client holding the above document(s) in hand"}]]}]

3d:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":"We implement enhanced due diligence for international wire transfers, consistent with FATF Recommendation 16 and Vanuatu's wire transfer obligations, including:"}]
3e:["$","ul",null,{"style":{"paddingLeft":24,"margin":"0 0 1em"},"children":[["$","li","Complete originator and beneficiary information verification",{"style":"$f:props:children:0:props:style","children":"Complete originator and beneficiary information verification"}],["$","li","Enhanced screening for transactions involving high-risk jurisdictions",{"style":"$f:props:children:0:props:style","children":"Enhanced screening for transactions involving high-risk jurisdictions"}],["$","li","Documentation of the purpose and nature of cross-border transfers",{"style":"$f:props:children:0:props:style","children":"Documentation of the purpose and nature of cross-border transfers"}],["$","li","Compliance with travel rule requirements for virtual asset transactions where applicable",{"style":"$f:props:children:0:props:style","children":"Compliance with travel rule requirements for virtual asset transactions where applicable"}]]}]
3f:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":"Correspondent banking enhanced due diligence includes assessment of correspondent institutions' AML/CFT programs, clear definition of roles and responsibilities, regular monitoring of correspondent banking activities, and termination procedures for unsatisfactory relationships."}]
40:["$","h2",null,{"style":"$7:props:children:0:1:props:children:props:children:3:props:style","children":"Section 11: Enterprise Risk Management Integration"}]
41:["$","p",null,{"style":"$7:props:children:0:1:props:children:props:children:4:props:style","children":"The Company integrates AML/CFT risk management within its broader enterprise risk management framework, ensuring that money laundering and terrorist financing risks are identified, assessed, and mitigated as part of the Company's overall risk governance structure. This includes regular board-level reporting on AML/CFT risk exposure and the effectiveness of control measures, as well as integration with operational risk management processes."}]

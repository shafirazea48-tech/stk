10:["$","p","1.11.",{"style":"$7:props:children:0:1:props:children:props:children:1:props:style","children":[["$","strong",null,{"style":{"color":"#f4f4f6"},"children":"1.11."}]," ","'Demo Account' means a simulated account on the Trading Platform. Its currency matches that of the Client's Real Account. Funds on a Demo Account do not form a financial liability of the Company to the Client."]}]
